package codes;



import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.io.*;
import java.util.*;
import java.util.List;


class Room {
    int id;
    String location;
    double price;
    double rating;
    boolean available;
    int distance;

    Room(int id, String location, double price, double rating, boolean available) {
        this.id = id;
        this.location = location;
        this.price = price;
        this.rating = rating;
        this.available = available;
        this.distance = Integer.MAX_VALUE;
    }
}

class User {
    String username, password, role;

    User(String u, String p, String r) {
        username = u;
        password = p;
        role = r;
    }
}


class Graph {
    static class Pair {
        String node;
        int weight;

        Pair(String n, int w) {
            node = n;
            weight = w;
        }
    }

    HashMap<String, List<Pair>> adj = new HashMap<>();

    void addEdge(String u, String v, int w) {
        adj.putIfAbsent(u, new ArrayList<>());
        adj.putIfAbsent(v, new ArrayList<>());
        adj.get(u).add(new Pair(v, w));
        adj.get(v).add(new Pair(u, w));
    }
}

public class Daagui {

    static ArrayList<Room> rooms = new ArrayList<>();
    static ArrayList<User> users = new ArrayList<>();
    static Graph g = new Graph();

    static JFrame frame;
    static CardLayout cardLayout;
    static JPanel mainPanel;

    static JTable adminTable, userTable;
    static DefaultTableModel adminModel, userModel;

    static JTextField loginUserField, regUserField;
    static JPasswordField loginPassField, regPassField;

    public static void main(String[] args) {
        loadRooms();
        loadUsers();

        if (users.isEmpty()) {
            users.add(new User("admin", "1234", "admin"));
            saveUsers();
        }

        // Graph setup
        g.addEdge("Premnagar", "ISBT", 3);
        g.addEdge("Premnagar", "Ballupur", 2);
        g.addEdge("ISBT", "Ballupur", 4);
        g.addEdge("ISBT", "ClockTower", 5);
        g.addEdge("Ballupur", "ClockTower", 3);

        createGUI();
    }

    
    static void createGUI() {
        frame = new JFrame("RoomRadar");
        frame.setSize(1100, 700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        cardLayout = new CardLayout();
        mainPanel = new JPanel(cardLayout);

        mainPanel.add(loginPanel(), "login");
        mainPanel.add(registerPanel(), "register");
        mainPanel.add(adminPanel(), "admin");
        mainPanel.add(userPanel(), "user");

        frame.add(mainPanel);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);

        cardLayout.show(mainPanel, "login");
    }

    
    static JPanel loginPanel() {
        JPanel panel = new JPanel(new GridLayout(5, 2, 12, 12));
        panel.setBorder(BorderFactory.createEmptyBorder(80, 150, 80, 150));

        loginUserField = new JTextField();
        loginPassField = new JPasswordField();

        JButton loginBtn = styledButton("Login");
        JButton registerBtn = styledButton("Register");

        panel.add(new JLabel("Username:"));
        panel.add(loginUserField);
        panel.add(new JLabel("Password:"));
        panel.add(loginPassField);
        panel.add(loginBtn);
        panel.add(registerBtn);

        loginBtn.addActionListener(e -> {
            String u = loginUserField.getText();
            String p = new String(loginPassField.getPassword());

            for (User user : users) {
                if (user.username.equals(u) && user.password.equals(p)) {
                    if (user.role.equals("admin"))
                        cardLayout.show(mainPanel, "admin");
                    else
                        cardLayout.show(mainPanel, "user");
                    return;
                }
            }
            JOptionPane.showMessageDialog(frame, "Invalid Login!");
        });

        registerBtn.addActionListener(e -> cardLayout.show(mainPanel, "register"));

        return panel;
    }

    static JPanel registerPanel() {
        JPanel panel = new JPanel(new GridLayout(5, 2, 12, 12));
        panel.setBorder(BorderFactory.createEmptyBorder(80, 150, 80, 150));

        regUserField = new JTextField();
        regPassField = new JPasswordField();

        JButton regBtn = styledButton("Register");
        JButton backBtn = styledButton("Back");

        panel.add(new JLabel("New Username:"));
        panel.add(regUserField);
        panel.add(new JLabel("Password:"));
        panel.add(regPassField);
        panel.add(regBtn);
        panel.add(backBtn);

        regBtn.addActionListener(e -> {
            users.add(new User(regUserField.getText(),
                    new String(regPassField.getPassword()), "user"));
            saveUsers();
            JOptionPane.showMessageDialog(frame, "Registered Successfully!");
            cardLayout.show(mainPanel, "login");
        });

        backBtn.addActionListener(e -> cardLayout.show(mainPanel, "login"));

        return panel;
    }

    static JPanel adminPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));

        adminModel = new DefaultTableModel(
                new String[]{"ID", "Location", "Price", "Distance", "Rating", "Available"}, 0);
        adminTable = new JTable(adminModel);

        refreshAdminTable(rooms);

        JPanel btnPanel = new JPanel(new GridLayout(2, 4, 10, 10));

        JButton addBtn = styledButton("Add");
        JButton updateBtn = styledButton("Update");
        JButton deleteBtn = styledButton("Delete");
        JButton searchBtn = styledButton("Search");
        JButton viewBtn = styledButton("View");
        JButton logoutBtn = styledButton("Logout");

        btnPanel.add(addBtn);
        btnPanel.add(updateBtn);
        btnPanel.add(deleteBtn);
        btnPanel.add(searchBtn);
        btnPanel.add(viewBtn);
        btnPanel.add(logoutBtn);

        addBtn.addActionListener(e -> addRoomDialog());
        updateBtn.addActionListener(e -> updateRoom());
        deleteBtn.addActionListener(e -> deleteRoom());
        searchBtn.addActionListener(e -> searchRoomAdmin());
        viewBtn.addActionListener(e -> refreshAdminTable(rooms));
        logoutBtn.addActionListener(e -> cardLayout.show(mainPanel, "login"));

        panel.add(new JScrollPane(adminTable), BorderLayout.CENTER);
        panel.add(btnPanel, BorderLayout.SOUTH);

        return panel;
    }

    
    static JPanel userPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));

        JPanel topPanel = new JPanel();

        JTextField locField = new JTextField(10);
        JTextField budgetField = new JTextField(8);

        JButton searchBtn = styledButton("Search Rooms");
        JButton bookBtn = styledButton("Book Room");
        JButton logoutBtn = styledButton("Logout");

        topPanel.add(new JLabel("Location:"));
        topPanel.add(locField);
        topPanel.add(new JLabel("Budget:"));
        topPanel.add(budgetField);
        topPanel.add(searchBtn);
        topPanel.add(bookBtn);
        topPanel.add(logoutBtn);

        userModel = new DefaultTableModel(
                new String[]{"ID", "Location", "Price", "Distance", "Rating", "Available"}, 0);
        userTable = new JTable(userModel);

        panel.add(topPanel, BorderLayout.NORTH);
        panel.add(new JScrollPane(userTable), BorderLayout.CENTER);

        searchBtn.addActionListener(e -> {
            String userLoc = locField.getText();
            double budget;

            try {
                budget = Double.parseDouble(budgetField.getText());
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(frame, "Invalid Budget!");
                return;
            }

            HashMap<String, Integer> distMap = dijkstra(g, userLoc);

            ArrayList<Room> filtered = new ArrayList<>();

            for (Room r : rooms) {
                if (r.price <= budget && r.available) {
                    r.distance = distMap.getOrDefault(r.location, 999);
                    filtered.add(r);
                }
            }

            filtered.sort((a, b) -> {
                if (a.distance != b.distance)
                    return a.distance - b.distance;
                return Double.compare(a.price, b.price);
            });

            refreshUserTable(filtered);
        });

        bookBtn.addActionListener(e -> bookRoom());
        logoutBtn.addActionListener(e -> cardLayout.show(mainPanel, "login"));

        refreshUserTable(rooms);

        return panel;
    }

    
    static void addRoomDialog() {
        JTextField idField = new JTextField();
        JTextField locField = new JTextField();
        JTextField priceField = new JTextField();
        JTextField ratingField = new JTextField();

        Object[] fields = {
                "ID:", idField,
                "Location:", locField,
                "Price:", priceField,
                "Rating:", ratingField
        };

        int option = JOptionPane.showConfirmDialog(frame, fields, "Add Room",
                JOptionPane.OK_CANCEL_OPTION);

        if (option == JOptionPane.OK_OPTION) {
            rooms.add(new Room(
                    Integer.parseInt(idField.getText()),
                    locField.getText(),
                    Double.parseDouble(priceField.getText()),
                    Double.parseDouble(ratingField.getText()),
                    true
            ));
            saveRooms();
            refreshAdminTable(rooms);
        }
    }

    static void updateRoom() {
        int row = adminTable.getSelectedRow();
        if (row < 0) return;

        int id = (int) adminModel.getValueAt(row, 0);

        for (Room r : rooms) {
            if (r.id == id) {
                r.available = !r.available;
                saveRooms();
                refreshAdminTable(rooms);
                return;
            }
        }
    }

    static void deleteRoom() {
        int row = adminTable.getSelectedRow();
        if (row < 0) return;

        int id = (int) adminModel.getValueAt(row, 0);
        rooms.removeIf(r -> r.id == id);

        saveRooms();
        refreshAdminTable(rooms);
    }

    static void searchRoomAdmin() {
        String keyword = JOptionPane.showInputDialog("Enter Location:");
        if (keyword == null) return;

        ArrayList<Room> filtered = new ArrayList<>();
        for (Room r : rooms) {
            if (r.location.equalsIgnoreCase(keyword))
                filtered.add(r);
        }

        refreshAdminTable(filtered);
    }

    static void bookRoom() {
        int row = userTable.getSelectedRow();
        if (row < 0) return;

        int id = (int) userModel.getValueAt(row, 0);

        for (Room r : rooms) {
            if (r.id == id && r.available) {
                r.available = false;
                saveRooms();
                refreshUserTable(rooms);
                JOptionPane.showMessageDialog(frame, "Room Booked!");
                return;
            }
        }
    }

    
    static void refreshAdminTable(ArrayList<Room> list) {
        adminModel.setRowCount(0);
        for (Room r : list) {
            adminModel.addRow(new Object[]{
                    r.id, r.location, r.price, r.distance, r.rating, r.available
            });
        }
    }

    static void refreshUserTable(ArrayList<Room> list) {
        userModel.setRowCount(0);
        for (Room r : list) {
            userModel.addRow(new Object[]{
                    r.id, r.location, r.price, r.distance, r.rating, r.available
            });
        }
    }


    static HashMap<String, Integer> dijkstra(Graph g, String src) {
        HashMap<String, Integer> dist = new HashMap<>();
        PriorityQueue<Graph.Pair> pq =
                new PriorityQueue<>(Comparator.comparingInt(p -> p.weight));

        pq.add(new Graph.Pair(src, 0));
        dist.put(src, 0);

        while (!pq.isEmpty()) {
            Graph.Pair curr = pq.poll();

            for (Graph.Pair nei : g.adj.getOrDefault(curr.node, new ArrayList<>())) {
                int newDist = curr.weight + nei.weight;

                if (!dist.containsKey(nei.node) || newDist < dist.get(nei.node)) {
                    dist.put(nei.node, newDist);
                    pq.add(new Graph.Pair(nei.node, newDist));
                }
            }
        }

        return dist;
    }

    
    static void loadRooms() {
        try (BufferedReader br = new BufferedReader(new FileReader("rooms.txt"))) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] d = line.split(",");
                rooms.add(new Room(
                        Integer.parseInt(d[0]),
                        d[1],
                        Double.parseDouble(d[2]),
                        Double.parseDouble(d[3]),
                        Boolean.parseBoolean(d[4])
                ));
            }
        } catch (Exception ignored) {
        }
    }

    static void saveRooms() {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter("rooms.txt"))) {
            for (Room r : rooms) {
                bw.write(r.id + "," + r.location + "," + r.price + "," + r.rating + "," + r.available);
                bw.newLine();
            }
        } catch (Exception ignored) {
        }
    }

    static void loadUsers() {
        try (BufferedReader br = new BufferedReader(new FileReader("users.txt"))) {
            String line;
            while ((line = br.readLine()) != null) {
                String[] d = line.split(",");
                users.add(new User(d[0], d[1], d[2]));
            }
        } catch (Exception ignored) {
        }
    }

    static void saveUsers() {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter("users.txt"))) {
            for (User u : users) {
                bw.write(u.username + "," + u.password + "," + u.role);
                bw.newLine();
            }
        } catch (Exception ignored) {
        }
    }

    
    static JButton styledButton(String text) {
        JButton btn = new JButton(text);
        btn.setFont(new Font("Arial", Font.BOLD, 14));
        return btn;
    }
}
